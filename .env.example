# ==============================================================================
# AAROH ENVIRONMENT CONFIGURATION (.env.example)
# Context-Aware Safety Navigation Platform for India
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE API & DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Service: FastAPI Monolith Backend
# Requirement: Optional (Defaults to localhost:8000)
PORT=8000
HOST=0.0.0.0
API_V1_STR=/api

# Service: PostgreSQL / PostGIS Spatial Database
# Requirement: Optional (System uses in-memory spatial cache when PostgreSQL is offline)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aaroh

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI API (Natural Language Route Explanation Layer)
# ------------------------------------------------------------------------------
# Service: Google AI Studio (Gemini 2.5 Flash / 1.5 Flash)
# Requirement: Optional (Deterministic fallback natural language summary used if empty)
# Cost: Free Tier Available (60 QPM)
GEMINI_API_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. OPENROUTESERVICE API KEY (Alternative Road Routing Engine)
# ------------------------------------------------------------------------------
# Service: OpenRouteService (Heidelberg Institute for Geoinformation Technology)
# Requirement: Optional (OSRM Public Engine & Snapped Waypoint Router used if empty)
# Cost: Free Tier Available (2,000 requests/day)
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here

# ------------------------------------------------------------------------------
# 4. FREE PUBLIC APIS (NO API KEY REQUIRED)
# ------------------------------------------------------------------------------
# Service 1: OpenStreetMap Nominatim Geocoding & Autocomplete API
# Endpoint: https://nominatim.openstreetmap.org/search
# Status: Free Public Access (Rate limit: 1 request/sec, User-Agent header enforced)

# Service 2: OpenStreetMap Overpass API (Dynamic Spatial Extraction)
# Endpoints:
# - https://overpass-api.de/api/interpreter
# - https://overpass.kumi.systems/api/interpreter
# Status: Free Public Access (Buffered spatial extraction for Emergency, Shops & Transit)

# Service 3: Open Source Routing Machine (OSRM)
# Endpoint: https://router.project-osrm.org/route/v1/driving/
# Status: Free Public Access (100% real-road routing geometries across India)
