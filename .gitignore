# ==============================================================================
# AAROH - Project Git Ignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Sensitive Credentials (CRITICAL - DO NOT COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# Databases & Local SQLite Runtime Data
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
aaroh.db
aaroh.db-shm
aaroh.db-wal

# ------------------------------------------------------------------------------
# Node.js & Next.js Frontend
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
.turbo/
.vercel/

# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js bundle analysis / telemetry
.next/cache/
next-env.d.ts

# ------------------------------------------------------------------------------
# Python & FastAPI Backend
# ------------------------------------------------------------------------------
# Bytecode and runtime caches
__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Operating System & IDE Artifacts
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains / PyCharm / WebStorm
.idea/
*.iml

# Vim / Emacs
*.swp
*.swo
*~
#*#

# ------------------------------------------------------------------------------
# Logs & Temporary Scratch Files
# ------------------------------------------------------------------------------
*.log
logs/
scratch/
